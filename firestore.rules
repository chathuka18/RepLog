rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tracker/{documentId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && documentId in ['replog_workouts_v1','replog_weights_v1','replog_body_v1','replog_completed_v1'];
    }
  }
}
